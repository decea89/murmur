  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675162}
  m_BlockName: Custom HLSL
  m_HLSLCode: "void SpringIron(inout VFXAttributes attributes, in float3 GrabStart,
    in float3 GrabDelta, in float GrabActive, in float InfluenceRadius, in float
    ReturnStiffness, in float StepTime, in float MotionTime, in float MotionAmplitude,
    in float MotionTwist) {\n float3 rest = attributes.targetPosition;\n float theta
    = atan2(rest.z,rest.x);\n float wave = sin(theta*3-MotionTime);\n float swell
    = sin(theta*2+MotionTime*0.7);\n float3 radial = normalize(float3(rest.x,0,rest.z));\n
    float3 offset = MotionAmplitude*(radial*(wave*0.65+swell*0.35)+float3(0,cos(theta*3-MotionTime)*0.8,0));\n
    float d = distance(rest,GrabStart);\n float w = 1-smoothstep(0,max(InfluenceRadius,0.01),d);\n
    float3 target = rest+offset+GrabDelta*w*GrabActive;\n float omega = sqrt(max(ReturnStiffness,0.01));\n
    float dt = clamp(StepTime,0,0.05);\n float3 x=attributes.position-target;\n float3
    j=attributes.velocity+omega*x;\n float decay=exp(-omega*dt);\n attributes.position=target+(x+j*dt)*decay;\n
    attributes.velocity=(attributes.velocity-omega*j*dt)*decay;\n float i=(float)(attributes.particleId%4000);\n
    float h=frac(sin(i*127.1+31.7)*43758.5453);\n float k=frac(sin(i*269.5+17.3)*22578.1459);\n
    attributes.angleY=-theta*57.29578+(h-0.5)*22;\n attributes.angleX=(k-0.5)*28+MotionTwist*wave;\n
    attributes.angleZ=(h-0.5)*20+MotionTwist*swell*0.4;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SpringIron
    selectedIndex: 0
