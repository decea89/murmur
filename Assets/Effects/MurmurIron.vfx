  m_InputSlots: []
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675155}
  m_BlockName: Custom HLSL
  m_HLSLCode: "void InitializeIron(inout VFXAttributes attributes) {\n uint i = attributes.particleId
    % 4000;\n float h = frac(sin((float)i * 127.1 + 31.7) * 43758.5453);\n float
    k = frac(sin((float)i * 269.5 + 17.3) * 22578.1459);\n float theta = ((i % 200)
    + frac((i / 200)*0.618034) + (h-0.5)*0.5) * 0.0314159265;\n float phi = ((i /
    200) + (k-0.5)*0.65) * 0.314159265;\n float r = 2.8 + 0.65*cos(phi);\n attributes.position
    = float3(r*cos(theta), 0.65*sin(phi), r*sin(theta));\n attributes.targetPosition
    = attributes.position;\n attributes.velocity = float3(0,0,0);\n attributes.size
    = 1;\n attributes.scaleX = lerp(0.045,0.068,h);\n attributes.scaleY = lerp(0.032,0.046,k);\n
    attributes.scaleZ = lerp(0.16,0.24,k);\n attributes.angleY = -theta*57.29578
    + (h-0.5)*22;\n attributes.angleX = (k-0.5)*28;\n attributes.angleZ = (h-0.5)*20;\n
    attributes.color = float3(0.48,0.52,0.57)*lerp(0.8,1.2,h);\n attributes.alpha
    = 1;\n attributes.lifetime = 1000000;\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: InitializeIron
    selectedIndex: 0
