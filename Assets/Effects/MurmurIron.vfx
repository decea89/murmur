  m_Script: {fileID: 11500000, guid: 833c3541f2af4b28b080abc2cd1a804d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.VisualEffectGraph.Editor::UnityEditor.VFX.Block.CustomHLSL
  m_UIIgnoredErrors: []
  m_Parent: {fileID: 114350483966675135}
  m_Children: []
  m_UIPosition: {x: 0, y: 0}
  m_UICollapsed: 0
  m_UISuperCollapsed: 0
  m_InputSlots:
  - {fileID: 114350483966675163}
  - {fileID: 114350483966675167}
  - {fileID: 114350483966675171}
  - {fileID: 114350483966675172}
  - {fileID: 114350483966675173}
  - {fileID: 114350483966675174}
  - {fileID: 114350483966675195}
  - {fileID: 114350483966675196}
  - {fileID: 114350483966675197}
  - {fileID: 114350483966675204}
  - {fileID: 114350483966675205}
  - {fileID: 114350483966675206}
  - {fileID: 114350483966675207}
  - {fileID: 114350483966675208}
  - {fileID: 114350483966675209}
  - {fileID: 114350483966675213}
  - {fileID: 114350483966675217}
  - {fileID: 114350483966675221}
  - {fileID: 114350483966675225}
  - {fileID: 114350483966675229}
  - {fileID: 114350483966675233}
  - {fileID: 114350483966675276}
  m_OutputSlots: []
  m_Disabled: 0
  m_ActivationSlot: {fileID: 114350483966675162}
  m_BlockName: Custom HLSL
  m_HLSLCode: "void SpringIron(inout VFXAttributes attributes, in float3 GrabStart,
    in float3 GrabDelta, in float GrabActive, in float InfluenceRadius, in float
    ReturnStiffness, in float StepTime, in float MotionTime, in float MotionAmplitude,
    in float MotionTwist, in float Collapsed, in float RecoveryTime, in float RebuildSpeed,
    in float Bounce, in float FloorFriction, in float3 WorldUpLocal, in float3 WorldRightLocal,
    in float3 WorldForwardLocal, in float3 SculptureOrigin, in float3 PlinthMin,
    in float3 PlinthMax, in float FloorHeight, in float4 ShapeWeights) {\n float3
    rest=attributes.targetPosition;\n float theta=atan2(rest.z,rest.x);\n float i=(float)(attributes.particleId%4000);\n
    float h=frac(sin(i*127.1+31.7)*43758.5453);\n float k=frac(sin(i*269.5+17.3)*22578.1459);\n
    // Analytic targets: no CPU particle updates or particle respawn on shape change.\n
    float originalTheta=theta;\n float u=frac((theta+3.14159265)/6.2831853);\n float
    radialOffset=length(rest.xz)-2.8;\n float p=u*5;float edge=floor(p);float a=edge*1.25663706-1.5707963;float
    b=a+1.25663706;\n float2 pent=lerp(float2(cos(a),sin(a)),float2(cos(b),sin(b)),frac(p))*3.1;\n
    float3 pentagon=float3(pent.x,rest.y*.55,pent.y)+float3(cos(theta),0,sin(theta))*radialOffset*.55;\n
    p=u*10;edge=floor(p);a=edge*.62831853-1.5707963;b=a+.62831853;\n float ra=fmod(edge,2)<.5?3.35:1.55;float
    rb=fmod(edge,2)<.5?1.55:3.35;\n float2 starLine=lerp(float2(cos(a),sin(a))*ra,float2(cos(b),sin(b))*rb,frac(p));\n
    float3 star=float3(starLine.x,rest.y*.4,starLine.y)+float3(cos(theta),0,sin(theta))*radialOffset*.4;\n
    float3 hand;\n float depth=(frac(i*.75487766)-.5)*.36;\n if(i<1800){float x=(h*2-1)*1.12;float
    y=lerp(-1.75,.65,k);float taper=lerp(.65,1,saturate((y+1.75)/1.2));hand=float3(x*taper,depth,-y);}\n
    else if(i<3600){float finger=floor((i-1800)/450);float t=frac((i-1800)/450);float
    x=(finger-1.5)*.62;float len=finger<.5?1.8:(finger<1.5?2.5:(finger<2.5?2.25:1.55));float
    s=sin(t*3.14159265);float width=.19*sqrt(max(.05,s));x+=(finger-1.5)*t*.18+(h*2-1)*width;hand=float3(x,depth*.8,-(.55+t*len));}\n
    else {float t=(i-3600)/400;hand=float3(-.85-t*1.25+(h*2-1)*.22,depth,-(-.55+t*1.65));}\n
    rest=rest*ShapeWeights.x+pentagon*ShapeWeights.y+star*ShapeWeights.z+hand*ShapeWeights.w;\n\n
    float dt=clamp(StepTime,0,.05);\n float3 up=normalize(WorldUpLocal);\n float
    sector=(theta+3.14159265)/6.2831853;\n float delay=sector*1.25;\n float localTime=max(0,RecoveryTime-delay);\n
    float finish=1.25+8/max(RebuildSpeed,.1);\n if(Collapsed>.5 || RecoveryTime<delay)
    {\n   // Ballistic integration with swept top-plane contacts, in sculpture-local
    space.\n   for(int step=0;step<2;step++) {\n     float ds=dt*.5;\n     float3
    old=attributes.position;\n     attributes.velocity-=up*9.81*ds;\n     attributes.velocity*=exp(-.12*ds);\n    
    attributes.position+=attributes.velocity*ds;\n     float3 world=SculptureOrigin+float3(dot(attributes.position,WorldRightLocal),dot(attributes.position,up),dot(attributes.position,WorldForwardLocal));\n    
    float oldY=SculptureOrigin.y+dot(old,up);\n     float radius=.045;\n     float
    surface=FloorHeight+radius;\n     bool inside=world.x>PlinthMin.x+.07 && world.x<PlinthMax.x-.07
    && world.z>PlinthMin.z+.07 && world.z<PlinthMax.z-.07;\n     if(inside && oldY>=PlinthMax.y+radius-.015)surface=max(surface,PlinthMax.y+radius);\n    
    float vn=dot(attributes.velocity,up);\n     if(world.y<surface && vn<0) {\n      
    attributes.position+=up*(surface-world.y);\n       float3 tangent=attributes.velocity-up*vn;\n      
    // Tiny deterministic lateral impact scatter stops all pieces stacking on a line.\n      
    if(vn<-.8)tangent+=(WorldRightLocal*(h-.5)+WorldForwardLocal*(k-.5))*(-vn)*.13;\n      
    attributes.velocity=tangent*exp(-FloorFriction*ds)+up*(vn<-.65?-vn*Bounce:0);\n      
    float settle=1-exp(-12*ds);\n       attributes.angleX=lerp(attributes.angleX,90,settle);\n      
    attributes.angleZ=lerp(attributes.angleZ,0,settle);\n     } else {\n       attributes.angleX+=(h-.5)*240*ds;\n      
    attributes.angleZ+=(k-.5)*200*ds;\n     }\n   }\n   return;\n }\n float wave=sin(theta*3-MotionTime);\n
    float swell=sin(theta*2+MotionTime*.7);\n float3 radial=normalize(float3(rest.x,0,rest.z));\n
    float3 offset=lerp(1,.12,ShapeWeights.w)*MotionAmplitude*(radial*(wave*.65+swell*.35)+float3(0,cos(theta*3-MotionTime)*.8,0));\n
    float w=1-smoothstep(0,max(InfluenceRadius,.01),distance(rest,GrabStart));\n
    float3 target=rest+offset+GrabDelta*w*GrabActive;\n // A rotating target unwinds
    into the original silhouette as the spring settles.\n float spiral=1.8*exp(-localTime*1.7)*smoothstep(0,.3,localTime);\n
    if(RecoveryTime<finish){float cs=cos(spiral),sn=sin(spiral);target.x=rest.x*cs-rest.z*sn+offset.x;target.z=rest.x*sn+rest.z*cs+offset.z;}\n
    // One restrained travelling ripple after the last fragments have converged.\n
    float pulseTime=RecoveryTime-finish-sector*.65;\n float pulse=(pulseTime>0 &&
    pulseTime<.5)?sin(pulseTime*6.2831853):0;\n target+=radial*pulse*.13;\n float
    omega=RecoveryTime<finish?max(RebuildSpeed,.1):sqrt(max(ReturnStiffness,.01));\n
    float3 x=attributes.position-target;\n float3 j=attributes.velocity+omega*x;\n
    float decay=exp(-omega*dt);\n attributes.position=target+(x+j*dt)*decay;\n attributes.velocity=(attributes.velocity-omega*j*dt)*decay;\n
    float orientationBlend=RecoveryTime<finish?1-exp(-4*dt):1;\n attributes.angleY=lerp(attributes.angleY,-theta*57.29578+(h-.5)*22,orientationBlend);\n
    attributes.angleX=lerp(attributes.angleX,(k-.5)*28+MotionTwist*wave,orientationBlend);\n
    attributes.angleZ=lerp(attributes.angleZ,(h-.5)*20+MotionTwist*swell*.4,orientationBlend);\n}\n"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunction:
    selection: SpringIron
    selectedIndex: 0
